{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(**/.env*)",
      "Read(**/.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.pgpass)",
      "Read(**/backend.env)",
      "Read(/etc/**/backend.env)",
      "Edit(**/.env*)",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.pgpass)",
      "Edit(**/backend.env)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Bash(uv run python -m app.jobs.daily_run:*)",
      "Bash(uv run alembic downgrade:*)",
      "Bash(psql:*)",
      "Bash(dropdb:*)",
      "Bash(pg_restore:*)"
    ],
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run uvicorn:*)",
      "Bash(uv run alembic upgrade:*)",
      "Bash(uv run alembic revision:*)",
      "Bash(uv run alembic current:*)",
      "Bash(uv run alembic history:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run preview:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(npx playwright install:*)",
      "Bash(npx playwright test:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(ls:*)"
    ]
  }
}
